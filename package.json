{
  "name": "chattar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "scripts": {
    "setup": "python scripts/setup.py",
    "dev": "docker compose up",
    "dev:build": "docker compose up --build",
    "restart": "docker compose restart",
    "restart:dashboard": "docker compose restart dashboard",
    "restart:backend": "docker compose restart backend",
    "restart:web": "docker compose restart web",
    "stop:dashboard": "docker compose stop dashboard",
    "stop:backend": "docker compose stop backend",
    "stop:web": "docker compose stop web",
    "down": "docker compose down",
    "clean": "rm -rf node_modules apps/*/node_modules shared/*/node_modules",
    "clean:containers": "docker compose down -v",
    "logs": "docker compose logs -f",
    "logs:backend": "docker compose logs -f backend",
    "logs:web": "docker compose logs -f web",
    "logs:dashboard": "docker compose logs -f dashboard",
    "dev:local": "concurrently \"cd apps/backend && bun run dev\" \"cd apps/web && bun run dev\"",
    "dev:backend-local": "\"cd apps/backend && bun run dev\"",
    "dev:web-local": "\"cd apps/web && bun run dev\"",
    "lint": "bunx eslint",
    "type-check": "bunx tsc --noEmit"
  },
  "packageManager": "bun@1.3.0",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5",
    "eslint": "9.39.2",
    "@eslint/js": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "@typescript-eslint/eslint-plugin": "8.46.4",
    "@typescript-eslint/parser": "8.46.4",
    "typescript-eslint": "8.46.4"
  },
  "dependencies": {
    "prettier": "^3.7.4"
  }
}
