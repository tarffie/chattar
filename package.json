{
  "name": "chattar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "shared/*"
  ],
  "scripts": {
    "setup": "python scripts/setup.py",
    "dev": "docker compose up",
    "dev:build": "docker compose up --build",
    "restart": "docker compose restart",
    "restart:dashboard": "docker compose restart dashboard",
    "restart:server": "docker compose restart server",
    "restart:web": "docker compose restart web",
    "stop:dashboard": "docker compose stop dashboard",
    "stop:server": "docker compose stop server",
    "stop:web": "docker compose stop web",
    "down": "docker compose down",
    "clean": "'rm -rfv **/node_modules'",
    "clean:containers": "docker compose down -v",
    "logs": "docker compose logs -f",
    "logs:server": "docker compose logs -f server",
    "logs:web": "docker compose logs -f web",
    "logs:dashboard": "docker compose logs -f dashboard",
    "dev:local": "concurrently \"cd apps/server && bun run dev\" \"cd apps/frontend && bun run dev\"",
    "lint": "bunx eslint",
    "type-check": "bunx tsc --noEmit"
  },
  "packageManager": "bun@1.3.0",
  "devDependencies": {
    "@types/bun": "latest",
    "eslint": "9.39.2",
    "@eslint/js": "9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "typescript-eslint": "^8.46.4",
    "@typescript-eslint/eslint-plugin": "8.53.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "prettier": "^3.7.4"
  }
}
